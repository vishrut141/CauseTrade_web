#!/bin/bash

set -e

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT_DIR="$(dirname "$APP_DIR")"
COMMAND_FILE="$PROJECT_DIR/Launch CauseTrade.command"

if [ ! -f "$COMMAND_FILE" ]; then
  osascript -e 'display alert "CauseTrade launcher error" message "Launch CauseTrade.command was not found next to the app." as critical'
  exit 1
fi

open -a Terminal "$COMMAND_FILE"

exit 0
