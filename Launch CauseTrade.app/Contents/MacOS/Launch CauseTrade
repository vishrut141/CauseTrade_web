#!/bin/bash

set -e

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT_DIR="$(dirname "$APP_DIR")"
COMMAND_FILE="$PROJECT_DIR/Launch CauseTrade.command"
URL="http://localhost:3000"

if [ ! -f "$COMMAND_FILE" ]; then
  osascript -e 'display alert "CauseTrade launcher error" message "Launch CauseTrade.command was not found next to the app." as critical'
  exit 1
fi

open -a Terminal "$COMMAND_FILE"

(
  for _ in $(seq 1 90); do
    if curl -fsS "$URL" >/dev/null 2>&1; then
      open "$URL"
      exit 0
    fi
    sleep 1
  done
  osascript -e 'display alert "CauseTrade server did not start" message "The dev server did not become reachable on http://localhost:3000 within 90 seconds."'
) >/dev/null 2>&1 &

exit 0
